# ==============================================================================
# ChatChat 环境变量模板（W1-M04 建立；W4-M05 扩服务段与池参数注释段）
#
# 用法：cp .env.example .env，然后修改各项取值（.env 已被 .gitignore 忽略，不入库）。
#
# 这些变量经 docker compose 的 --env-file .env 注入（make compose-*/full-*
# 目标已内置该参数），用于 deployments/docker-compose.yml 与
# deployments/docker-compose.services.yml 的插值与容器环境注入。
# 缺失必填项（MYSQL_ROOT_PASSWORD / CHATCHAT_JWT_SECRET）时 compose up
# 直接报错，不会静默降级。
#
# 应用侧（config.toml / CHATCHAT_* 环境变量）与本文件的对齐关系
# 见 README「基础设施（docker-compose）」章节的对齐表。
# ==============================================================================

# ------------------------------------------------------------------------------
# 一、基础设施（docker-compose 三件套）
# ------------------------------------------------------------------------------

# MySQL（mysql:8.0）

# 【必填】MySQL root 密码。compose 校验缺失/空值即报错；请务必改成强密码。
# 应用连接时需以 CHATCHAT_MYSQL_PASSWORD 注入同一值（或写入本地 config.toml）。
MYSQL_ROOT_PASSWORD=change-me-root

# 首次初始化时自动创建的数据库（须与 config.toml mysql.database 对齐）。
MYSQL_DATABASE=chatchat

# 宿主机侧端口映射（容器内端口固定 3306；宿主机端口冲突时只改这里）。
MYSQL_PORT=3306

# Redis（redis:7）

# AOF 持久化开关：yes | no（默认 no，对齐开发期轻量使用；改 yes 后数据经卷持久化）。
REDIS_APPENDONLY=no

# 宿主机侧端口映射（容器内端口固定 6379）。
REDIS_PORT=6379

# Kafka（apache/kafka:3.9.0，KRaft 单节点）

# 宿主机侧端口映射（容器内端口固定 9092；应用侧 brokers 默认 127.0.0.1:9092）。
# W4-M05 起 broker 双 listener：宿主走 EXTERNAL localhost:9092（本端口），
# 服务容器走 INTERNAL kafka:29092（不发布宿主）——见 README「容器全栈」。
KAFKA_PORT=9092

# topic 分区数（W4-M05）：full-* 形态的 topics-init 一次性建题分区数
#（默认 6）。注意：make topics（本地形态建题/扩分区口径）用 Makefile 的
# KAFKA_PARTITIONS 变量——两处同名但作用域不同（本值只喂 compose 插值）。
KAFKA_PARTITIONS=6

# ------------------------------------------------------------------------------
# 二、服务段（容器全栈形态必需——make full-* 消费）
# ------------------------------------------------------------------------------

# 【必填，仅 full-* 形态】JWT 签名密钥（>=32 字节，config 校验强制；仅 env
# 注入，禁入 config.toml）。生成示例（Git Bash）：
#   head -c 48 /dev/urandom | base64
# compose 经 ${CHATCHAT_JWT_SECRET} 透传给四服务容器；缺失时 compose 直接
# 报错（部署密钥应显式，full-up 不自动生成）。本地 make run 形态不需要
# 本值（ensure-env 自动生成并落 logs/run/env）。
CHATCHAT_JWT_SECRET=change-me-generate-with-head-c-48-dev-urandom-base64

# 网关 ID（W4-M05）：docker-compose.services.yml 为 gateway/pushpull 内置
# 稳定值 chatchat-gateway-1（多实例时 -2/-3 递增，防 push 消费组随容器
# 重建漂移）。仅当自行改写 overlay 或单跑容器时才需要在本文件覆盖：
# CHATCHAT_WS_GATEWAY_ID=chatchat-gateway-1

# 三依赖地址覆盖（容器形态由 overlay 内置 mysql:3306 / redis:6379 /
# kafka:29092，无需在本文件配置；宿主进程形态走 config 默认 127.0.0.1。
# 需要覆盖时的键）：CHATCHAT_MYSQL_HOST / CHATCHAT_MYSQL_PORT /
# CHATCHAT_MYSQL_PASSWORD / CHATCHAT_REDIS_ADDR / CHATCHAT_KAFKA_BROKERS
#（逗号分隔）——完整键表见 config/envKeys（config.go）。

# ------------------------------------------------------------------------------
# 三、池参数与资源档对齐（注释段——W4-M05 移交 14 对齐登记，无变量）
# ------------------------------------------------------------------------------
# 容器全栈资源限制档（docker-compose.services.yml deploy.resources.limits，
# 保守值）：mysql 1g / redis 256m / kafka 2g / api 192m / gateway 256m /
# logic 64m / pushpull 256m / topics-init 64m。
#
# 与默认池参数的对应关系（config 默认值，不经本文件调整）：
#   - mysql.max_open_conns=20 / max_idle_conns=10：四服务合计 <=80 连接，
#     MySQL 1g 档宽裕（默认 max_connections=151）；
#   - redis.pool_size=50：gateway/pushpull/api 各 50，256m 档可受；
#   - kafka 2g：KRaft 单节点 JVM 默认堆 + 页缓存（历史 4GB 建议的保守下探，
#     OOM 时按 Docker Desktop 实测上调并登记）。
# 压测级调优归 M07（plan §10 假设登记：单宿主部署、scrape 低频）。
# ==============================================================================
